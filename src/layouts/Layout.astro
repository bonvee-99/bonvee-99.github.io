---
import Navigation from '../components/Navigation.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			// Set theme + js class before paint to avoid a flash.
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t !== 'light' && t !== 'coffee' && t !== 'dark') {
						t = 'light'; // default to light; respect an explicit user toggle
					}
					document.documentElement.dataset.theme = t;
				} catch (e) {}
				document.documentElement.classList.add('js');
			})();
		</script>
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Software engineer portfolio of Ben Vinnick featuring full-stack web development projects and experience.">
		<meta property="og:title" content="Ben Vinnick – Portfolio" />
		<meta property="og:description" content="Explore the work and experience of Ben Vinnick, full-stack developer." />
		<meta property="og:url" content="https://benvinnick.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
		<title>Ben Vinnick</title>
	</head>
	<body>
		<div class="bg-grain"></div>
		<Navigation />
		<main>
			<slot />
		</main>
		<script>
			// Reveal elements as they scroll into view (progressive enhancement).
			const els = document.querySelectorAll('[data-reveal]');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduce && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
				);
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add('is-visible'));
			}
		</script>
	</body>
</html>

<style is:global>
:root {
  --bg: #FAF9F6;
  --bg-soft: #f3f1ea;
  --surface: #ffffff;
  --text: #1a1a1a;
  --muted: #6b6963;
  --accent: #F2944B;
  --accent-soft: #fde7d2;
  --link: #0d6bb4;
  --border: rgba(10, 10, 10, 0.08);
  --shadow-sm: 0 1px 2px rgba(10, 10, 10, 0.04), 0 2px 6px rgba(10, 10, 10, 0.04);
  --shadow-md: 0 2px 8px rgba(10, 10, 10, 0.06), 0 8px 24px rgba(10, 10, 10, 0.06);
  --grain-1: rgba(242, 148, 75, 0.10);
  --grain-2: rgba(13, 107, 180, 0.07);
}

:root[data-theme="coffee"] {
  --bg: #e5d6bf;
  --bg-soft: #dbc9ad;
  --surface: #efe4d1;
  --text: #3b2e21;
  --muted: #7a6653;
  --accent: #c4622e;
  --accent-soft: rgba(196, 98, 46, 0.18);
  --link: #0e6b63;
  --border: rgba(59, 46, 33, 0.16);
  --shadow-sm: 0 1px 2px rgba(59, 40, 20, 0.10), 0 2px 6px rgba(59, 40, 20, 0.08);
  --shadow-md: 0 2px 8px rgba(59, 40, 20, 0.12), 0 8px 24px rgba(59, 40, 20, 0.12);
  --grain-1: rgba(196, 98, 46, 0.12);
  --grain-2: rgba(123, 74, 36, 0.08);
}

:root[data-theme="dark"] {
  --bg: #1a1815;
  --bg-soft: #232019;
  --surface: #262320;
  --text: #f3efe8;
  --muted: #a8a196;
  --accent: #f2944b;
  --accent-soft: rgba(242, 148, 75, 0.16);
  --link: #6bb2ec;
  --border: rgba(255, 255, 255, 0.10);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.30), 0 2px 6px rgba(0, 0, 0, 0.24);
  --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.36), 0 10px 28px rgba(0, 0, 0, 0.40);
  --grain-1: rgba(242, 148, 75, 0.14);
  --grain-2: rgba(13, 107, 180, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scrollbar-gutter: stable;
}

html, body {
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Inter', system-ui, -apple-system, Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
  position: relative;
  transition: background-color 0.3s ease, color 0.3s ease;
}

h1, h2, h3, h4, h5 {
  font-family: 'Fraunces', Georgia, serif;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.bg-grain {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(1200px 600px at 10% -10%, var(--grain-1), transparent 60%),
    radial-gradient(900px 500px at 110% 10%, var(--grain-2), transparent 60%);
}

main {
  position: relative;
  z-index: 1;
}

a {
  color: var(--link);
  text-decoration: none;
  transition: color 0.15s ease;
}

a:hover {
  color: var(--accent);
}

::selection {
  background: var(--accent-soft);
  color: var(--text);
}

/* Smooth theme switch on surfaces */
.card,
.group,
nav {
  transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease,
    transform 0.2s ease, box-shadow 0.2s ease;
}

/* Scroll-reveal (only when JS is on, motion allowed) */
@media (prefers-reduced-motion: no-preference) {
  html.js [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  html.js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
}
</style>
